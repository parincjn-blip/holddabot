{
  "name": "disbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dashboard": "node dist/dashboard.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/unit.test.mjs tests/dashboard.test.mjs tests/dashboard-http.test.mjs tests/rank-up-card.test.mjs",
    "db:migrate": "tsx src/migrate.ts",
    "config:import": "node scripts/import-legacy-config.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
